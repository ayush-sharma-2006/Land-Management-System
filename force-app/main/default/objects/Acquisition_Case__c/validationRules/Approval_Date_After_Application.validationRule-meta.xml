<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Approval_Date_After_Application</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Approval_Date__c)),
    Approval_Date__c &lt; Application_Date__c
)</errorConditionFormula>
    <errorMessage>Approval date after Application</errorMessage>
</ValidationRule>
