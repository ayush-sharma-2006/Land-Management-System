<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Verification_Date_After_Application_date</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK( Verification_Date__c )),
    Verification_Date__c &lt; Application_Date__c
)</errorConditionFormula>
    <errorMessage>verification date after application date</errorMessage>
</ValidationRule>
