<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Risk_Score_Must_Be_Valid</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
    Risk_Score__c &lt; 0,
    Risk_Score__c &gt; 1
)</errorConditionFormula>
    <errorMessage>Risk Score must be between 0% and 100%.</errorMessage>
</ValidationRule>
