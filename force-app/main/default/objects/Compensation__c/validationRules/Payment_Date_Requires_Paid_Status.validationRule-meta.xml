<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Payment_Date_Requires_Paid_Status</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Payment_Date__c)),
    NOT(ISPICKVAL(Payment_Status__c, &quot;Paid&quot;))
)</errorConditionFormula>
    <errorMessage>Payment Date can only be entered when Payment Status is Paid.</errorMessage>
</ValidationRule>
