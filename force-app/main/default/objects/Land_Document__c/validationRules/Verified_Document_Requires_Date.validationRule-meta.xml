<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Verified_Document_Requires_Date</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Verification_Status__c, &quot;Verified&quot;),
    ISBLANK(Verified_Date__c)
)</errorConditionFormula>
    <errorMessage>Verified Date is required when the document is Verified.</errorMessage>
</ValidationRule>
